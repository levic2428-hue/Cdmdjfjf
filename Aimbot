title.BackgroundTransparency = 1
title.Text = "ECT AND NICKOY"
title.TextColor3 = Color3.fromRGB(205, 160, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 17
title.Parent = panel

local lockButton = Instance.new("TextButton")
